{
  "$schema": "https://json.openmrs.org/routes.schema.json",
  "backendDependencies": {
    "fhir2": ">=1.2",
    "webservices.rest": "^2.24.0"
  },
  "extensions": [
   
    {
      "name": "ncd-dashboard-slot",
      "component": "ncdDashboardLink",
